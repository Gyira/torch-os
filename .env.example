APP_ENV=development
HOST=127.0.0.1
PORT=8765
# Keep remote access disabled unless you understand the data exposure risk.
ALLOW_REMOTE_API=false
API_TOKEN=
DATA_DIR=./data
VAULT_DIR=./data/vault
# DeepSeek Harness (the only AI surface). Leave command empty to auto-detect
# dsh, then npx. Model keys and permissions belong to dsh, not torch.
TORCH_DSH_COMMAND=
TORCH_DSH_WORKSPACE=
# 恋爱系统（原生模块）。默认复用原「恋爱分析助手」的本地数据：
#   LOVE_DB_PATH   %LOCALAPPDATA%\love-analysis-assistant\love_analysis.db
#   LOVE_APP_DIR   原项目目录（用于交路表 Excel 与车次时刻表；不填则只有丽洁追踪不可用）
#   LOVE_EXCEL_DIR / LOVE_TIMETABLE_PATH 可按需单独覆盖
LOVE_DB_PATH=
LOVE_APP_DIR=
LOVE_EXCEL_DIR=
LOVE_TIMETABLE_PATH=
# AI 分析使用的 DeepSeek 接口；Key 在「工作台 → 恋爱系统 → 设置」里配置并加密存储。
LOVE_API_BASE_URL=https://api.deepseek.com/v1
LOVE_API_MODEL=deepseek-chat
