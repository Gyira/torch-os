APP_ENV=development
HOST=127.0.0.1
PORT=8765
# Keep remote access disabled unless you understand the data exposure risk.
ALLOW_REMOTE_API=false
API_TOKEN=
DATA_DIR=./data
VAULT_DIR=./data/vault
MODEL_PROVIDER=local
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45
# Local embeddings for semantic memory search: hash (offline fallback) | ollama | none
EMBEDDING_PROVIDER=hash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3
