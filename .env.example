APP_ENV=development
HOST=127.0.0.1
PORT=8765
# Keep remote access disabled unless you understand the data exposure risk.
ALLOW_REMOTE_API=false
API_TOKEN=
DATA_DIR=./data
VAULT_DIR=./data/vault
# DeepSeek Harness (the only AI surface). Leave command empty to auto-detect
# dsh, then npx. Model keys and permissions belong to dsh, not torch.
TORCH_DSH_COMMAND=
TORCH_DSH_WORKSPACE=
# B4b: 人生导师经服务端校验后直接更新档案（默认 1）。
# 设为 0 回退为旧待确认卡；不会删除已写入条目或历史。
TORCH_MENTOR_AUTONOMOUS_ARCHIVE=1
# 恋爱系统（原生模块）。运行时数据统一放在当前个人数据库的 .torch-os/love/：
#   love_analysis.db / .api_key.key / xlsx/ / schedule-notes.json / cn_stopwords.txt
# 车次时刻表已独立到 <Vault>/.torch-os/train-tracker/；LOVE_TIMETABLE_PATH 只作旧时刻表迁移来源。
# 旧版位置只在首次启动时复制到新目录（原文件保留）：
#   LOVE_DB_PATH   %LOCALAPPDATA%\love-analysis-assistant\love_analysis.db
#   LOVE_APP_DIR   原项目目录（旧时刻表与停用词）
#   LOVE_EXCEL_DIR / LOVE_TIMETABLE_PATH / LOVE_STOPWORDS_PATH 旧版文件位置
#   LOVE_DATA_DIR  旧版恋爱数据目录；v2 只作为迁移来源，新数据在
#                  <Vault>/02_生活运营/01_恋爱系统/
#   LOVE_TARGET_NAME 排班对象姓名：只在本机 .env 配置，仓库与接口都不写/不显示真实姓名
LOVE_DATA_DIR=
LOVE_DB_PATH=
LOVE_APP_DIR=
LOVE_EXCEL_DIR=
LOVE_TIMETABLE_PATH=
LOVE_STOPWORDS_PATH=
LOVE_TARGET_NAME=
# AI 分析使用的 DeepSeek 接口；Key 在「工作台 → 恋爱系统 → 设置」里配置并加密存储。
# v2 起恋爱系统 AI 走 dsh，不再读取这两个变量；保留只为旧版 love.py 兼容。
LOVE_API_BASE_URL=https://api.deepseek.com/v1
LOVE_API_MODEL=deepseek-chat
